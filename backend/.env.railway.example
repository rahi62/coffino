# Cafino Backend / Worker / Beat — Railway production template
# Paste values into Railway Variables. Do not commit real secrets.

CAF_INO_ENV=saas
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<strong-random-secret>
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
DJANGO_DB_CONN_MAX_AGE=60

# Reference Railway services instead of copying credentials.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}

# Add custom API host only when you use one. Railway-provided public/private
# domains and healthcheck.railway.app are added automatically at runtime.
DJANGO_ALLOWED_HOSTS=api.example.com

# Set after the Frontend HTTPS domain is known. Comma-separated if needed.
CAF_INO_FRONTEND_ORIGIN=https://app.example.com

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_WORKER_CONCURRENCY=2

# Optional Production Operations / Local fleet control-plane verification key.
CAF_INO_LICENSE_PUBLIC_KEY_PEM=
CAF_INO_OPS_EVENT_RETENTION_DAYS=90
CAF_INO_OPS_DIAGNOSTIC_RETENTION_DAYS=30
