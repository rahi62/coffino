# Cafino Backend — Coolify production environment example
# Values marked CHANGE_ME must be configured as secrets in Coolify.

CAF_INO_ENV=saas
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=cafenoapi.digitalafarin.ir
DJANGO_TIME_ZONE=Asia/Tehran

CAF_INO_FRONTEND_ORIGIN=https://cafeno.digitalafarin.ir
CORS_ALLOWED_ORIGINS=https://cafeno.digitalafarin.ir
CSRF_TRUSTED_ORIGINS=https://cafeno.digitalafarin.ir

DATABASE_URL=CHANGE_ME
REDIS_URL=CHANGE_ME
CELERY_BROKER_URL=CHANGE_ME
DJANGO_CACHE_URL=CHANGE_ME

DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600

# Set to the exact number of trusted reverse proxies in front of Django.
# For a direct single Coolify proxy topology this is typically 1; verify before release.
CAF_INO_NUM_PROXIES=1

# Platform OTP. Keep disabled until ParsGreen credentials and a controlled
# non-production delivery test have been verified.
PARSGREEN_OTP_ENABLED=0
PARSGREEN_API_BASE_URL=https://sms.parsgreen.ir
PARSGREEN_API_KEY=CHANGE_ME
PARSGREEN_SIGNATURE=CHANGE_ME
PARSGREEN_OTP_ADD_NAME=1
PARSGREEN_TIMEOUT_SECONDS=10

CAF_INO_OTP_TTL_SECONDS=300
CAF_INO_OTP_GRANT_TTL_SECONDS=300
CAF_INO_OTP_RESEND_SECONDS=60
CAF_INO_OTP_MAX_ATTEMPTS=5
CAF_INO_OTP_SEND_LIMIT_PER_HOUR=5
CAF_INO_OTP_VERIFY_LIMIT_PER_HOUR=20
CAF_INO_OTP_RETENTION_DAYS=7
