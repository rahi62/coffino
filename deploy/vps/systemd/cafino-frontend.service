[Unit]
Description=Cafino Next.js Frontend
After=network-online.target cafino-backend.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=__ROOT__/frontend
EnvironmentFile=/etc/cafino/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 9861
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
